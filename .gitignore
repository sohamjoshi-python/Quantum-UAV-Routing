# ---------------------------------------------------------------------------
# Secrets / credentials
# ---------------------------------------------------------------------------
# Holds QISKIT_IBM_TOKEN and any other provider keys; must never be committed.
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------
# The GMNS+ Phoenix dataset is auto-downloaded (data/GMNS_Plus_Dataset/) and the
# 3D-lifted network (node_3d.csv, link_3d.csv, node2d_to_3d_mapping.csv) is
# regenerated by scripts/run_experiment.py. Everything under data/ is derived and
# should be rebuilt from source rather than tracked.
data/

# ---------------------------------------------------------------------------
# Python caches, build artifacts, virtual environments
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# PuLP / CBC solver scratch files
# ---------------------------------------------------------------------------
# Written to the repo root by the ILP solver at runtime (OptimalAssignment-pulp.*).
*-pulp.mps
*-pulp.mst
*-pulp.sol
*-pulp.lp

# ---------------------------------------------------------------------------
# Stray / ad-hoc outputs written outside results/
# ---------------------------------------------------------------------------
ranking_90v180.csv

# ---------------------------------------------------------------------------
# Antiquated capacity-3 experiments (not part of the paper)
# ---------------------------------------------------------------------------
# The paper uses vehicle capacity nu = 2 throughout; higher capacities are listed
# only as future work. These capacity-3 generalization scripts/outputs were cut
# from the reported results and are excluded to keep the companion repo aligned
# with the paper.
scripts/run_capacity3_le60.py
scripts/verify_capacity3.py
scripts/compare_sa_sweeps_capacity3.py
src/quantum_uav_routing/rtv/build_trips_capacity3.py
results/experiment_results_capacity3.csv
results/experiment_results_capacity3_per_request.csv

# ---------------------------------------------------------------------------
# OS / editor cruft
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
